---
// Playground only: the changelog lives in its own collection with its own
// schema, and this route publishes it at `/changelog/entry/<id>/` — a path the
// entry ids do not carry. Rendered through `<StarlightPage>` so the pages get
// Starlight's chrome, which is how a real site would do it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('changelog');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<StarlightPage frontmatter={{ title: entry.data.title, description: entry.data.description }}>
  <p>
    <strong>{entry.data.area}</strong> · {entry.data.changeType} ·
    {entry.data.date.toISOString().slice(0, 10)}
  </p>
  <Content />
</StarlightPage>
