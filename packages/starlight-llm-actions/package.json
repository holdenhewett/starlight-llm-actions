{
  "name": "starlight-llm-actions",
  "version": "0.11.0",
  "type": "module",
  "description": "Starlight plugin: Page Actions dropdown with Copy/View/PDF and Open-in-LLM buttons (ChatGPT, Claude, Gemini, Perplexity, T3 Chat, Cursor, Copilot).",
  "license": "MIT",
  "author": "Holden Hewett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holdenhewett/starlight-llm-actions.git",
    "directory": "packages/starlight-llm-actions"
  },
  "homepage": "https://holdenhewett.github.io/starlight-llm-actions/",
  "bugs": {
    "url": "https://github.com/holdenhewett/starlight-llm-actions/issues"
  },
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "starlight",
    "starlight-plugin",
    "astro",
    "documentation",
    "llm",
    "ai",
    "chatgpt",
    "claude",
    "gemini",
    "perplexity",
    "cursor",
    "page-actions",
    "copy-as-markdown",
    "open-in-chatgpt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noCheck && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --noCheck --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./route": "./dist/route.ts",
    "./routes/llms-txt": "./dist/routes/llms-txt.ts",
    "./routes/llms-bundle": "./dist/routes/llms-bundle.ts",
    "./route-middleware": {
      "types": "./dist/route-middleware.d.ts",
      "default": "./dist/route-middleware.js"
    },
    "./internal/simple-markdown": "./dist/internal/simple-markdown.ts",
    "./overrides/PageTitle.astro": "./dist/overrides/PageTitle.astro",
    "./components/PageActions.astro": "./dist/components/PageActions.astro"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@astrojs/mdx": ">=4.0.0",
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.6.0",
    "hast-util-select": ">=6.0.0",
    "rehype-parse": ">=9.0.0",
    "rehype-remark": ">=10.0.0",
    "remark-gfm": ">=4.0.0",
    "remark-stringify": ">=11.0.0",
    "unified": ">=11.0.0",
    "unist-util-remove": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/mdx": {
      "optional": true
    },
    "hast-util-select": {
      "optional": true
    },
    "rehype-parse": {
      "optional": true
    },
    "rehype-remark": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-stringify": {
      "optional": true
    },
    "unified": {
      "optional": true
    },
    "unist-util-remove": {
      "optional": true
    }
  },
  "dependencies": {
    "picomatch": "^4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/starlight": "^0.41.7",
    "@types/hast": "^3.0.5",
    "@types/micromatch": "^4.0.10",
    "@types/picomatch": "^4.0.3",
    "astro": "^7.2.3",
    "hast-util-select": "^6.0.4",
    "micromatch": "^4.0.8",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0",
    "vitest": "^4.1.11"
  }
}
